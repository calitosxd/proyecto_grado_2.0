# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - INVERNADERO COTECNOVA
# Copia este archivo como .env y coloca tus credenciales locales de MySQL.
# ==============================================================================

# Entorno de la aplicación (development | production)
APP_ENV=development
APP_PORT=8085

# Conexión a Base de Datos MySQL (XAMPP / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Base_Datos_Proyecto
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
